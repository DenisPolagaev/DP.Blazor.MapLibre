<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>DP.Blazor.MapLibre.PmtilesPlugin</PackageId>
        <Description>PMTiles protocol plugin for DP.Blazor.MapLibre (pmtiles:// sources via HTTP Range).</Description>
        <StaticWebAssetBasePath>_content/PmtilesPlugin</StaticWebAssetBasePath>
        <RootNamespace>DP.Blazor.MapLibre.PmtilesPlugin</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageTags>Blazor;MapLibre;PMTiles;Plugin</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="wwwroot\**\*" />
        <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DP.Blazor.MapLibre\DP.Blazor.MapLibre.csproj" />
    </ItemGroup>

</Project>
