<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>DP.Blazor.MapLibre.MinimapPlugin</PackageId>
        <Description>Minimap control plugin for DP.Blazor.MapLibre.</Description>
        <StaticWebAssetBasePath>_content/MinimapPlugin</StaticWebAssetBasePath>
        <RootNamespace>DP.Blazor.MapLibre.MinimapPlugin</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageTags>Blazor;MapLibre;Minimap;Plugin</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="wwwroot\**\*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DP.Blazor.MapLibre\DP.Blazor.MapLibre.csproj" />
    </ItemGroup>

</Project>
