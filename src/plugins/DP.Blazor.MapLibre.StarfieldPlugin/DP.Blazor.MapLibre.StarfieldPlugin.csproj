<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>DP.Blazor.MapLibre.StarfieldPlugin</PackageId>
        <Description>Starfield and atmospheric glow backdrop plugin for DP.Blazor.MapLibre (maplibre-gl-starfield).</Description>
        <StaticWebAssetBasePath>_content/StarfieldPlugin</StaticWebAssetBasePath>
        <RootNamespace>DP.Blazor.MapLibre.StarfieldPlugin</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageTags>Blazor;MapLibre;Starfield;Globe;Plugin</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="wwwroot\**\*" />
        <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DP.Blazor.MapLibre\DP.Blazor.MapLibre.csproj" />
    </ItemGroup>

</Project>
