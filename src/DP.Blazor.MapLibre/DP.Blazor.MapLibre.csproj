<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>DP.Blazor.MapLibre</PackageId>
        <Description>C# wrapper around MapLibre GL JS for Blazor.</Description>
        <RootNamespace>DP.Blazor.MapLibre</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>

        <!-- Generate XML documentation file -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn> <!-- Suppresses missing XML comment warnings -->

        <!-- Single source of truth for the bundled MapLibre GL JS version. -->
        <MapLibreGlVersionFile>$(MSBuildProjectDirectory)\maplibre-gl.version</MapLibreGlVersionFile>
        <MapLibreGlVersionResourceName>DP.Blazor.MapLibre.MapLibreGlVersion</MapLibreGlVersionResourceName>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <EmbeddedResource Include="$(MapLibreGlVersionFile)" LogicalName="$(MapLibreGlVersionResourceName)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OneOf" Version="3.0.271" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
        <PackageReference Include="System.Text.Json" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <!-- maplibre-gl under wwwroot is committed; update via: libman restore (do not add LibraryManager.Build — it races under multi-TFM CI). -->
        <Content Remove="libman.json" />
        <None Include="libman.json" />
    </ItemGroup>

    <!--
      When bumping MapLibre GL JS, edit maplibre-gl.version first, then make libman.json
      and ts/package.json agree. This target fails the build on drift so the bundler,
      the TypeScript types and the JS cache-busting token can never get out of sync.
    -->
    <Target Name="ValidateMapLibreGlVersion" BeforeTargets="PrepareForBuild">
        <ReadLinesFromFile File="$(MapLibreGlVersionFile)">
            <Output TaskParameter="Lines" ItemName="_MapLibreGlVersionLines" />
        </ReadLinesFromFile>
        <PropertyGroup>
            <MapLibreGlVersion>@(_MapLibreGlVersionLines)</MapLibreGlVersion>
            <_LibManJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\libman.json'))</_LibManJson>
            <_TsPackageJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ts\package.json'))</_TsPackageJson>
        </PropertyGroup>
        <Error Condition="'$(MapLibreGlVersion)' == ''"
               Text="maplibre-gl.version is empty or missing. It must contain the bundled MapLibre GL JS version, e.g. 6.11.2." />
        <Error Condition="!$(_LibManJson.Contains('&quot;maplibre-gl@$(MapLibreGlVersion)&quot;'))"
               Text="libman.json must reference maplibre-gl@$(MapLibreGlVersion) to match maplibre-gl.version." />
        <Error Condition="!$(_TsPackageJson.Contains('&quot;maplibre-gl&quot;: &quot;$(MapLibreGlVersion)&quot;'))"
               Text="ts/package.json must pin maplibre-gl to $(MapLibreGlVersion) to match maplibre-gl.version." />
    </Target>
</Project>
