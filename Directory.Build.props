<Project>
  <!-- Isolate submodule from repo-wide Directory.Build.props (TFM, TreatWarningsAsErrors, CPM). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Denis Polagaev</Authors>
    <Company>Denis Polagaev</Company>
    <Copyright>Copyright (c) Denis Polagaev</Copyright>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DenisPolagaev/DP.Blazor.MapLibre</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DenisPolagaev/DP.Blazor.MapLibre</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <Version>2.0.2</Version>
    <PackageTags>Blazor;MapLibre;Components;Maps</PackageTags>
    <PackageIconUrl>https://maplibre.org/img/maplibre-logos/maplibre-logo-square-dark-blue-bg.png</PackageIconUrl>
  </PropertyGroup>
</Project>
