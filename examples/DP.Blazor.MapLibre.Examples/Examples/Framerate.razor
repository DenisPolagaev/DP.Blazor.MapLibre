@page "/examples/framerate"

@using DP.Blazor.MapLibre.FrameratePlugin
@using DP.Blazor.MapLibre.Models
@using DP.Blazor.MapLibre.Models.Control
@implements IAsyncDisposable

<ViewOnGitHub FilePath="examples/DP.Blazor.MapLibre.Examples/Examples/Framerate.razor"/>

<p class="text-muted">
  Frame rate overlay while the map is moving, adapted from
  <a href="https://github.com/mapbox/mapbox-gl-framerate" target="_blank" rel="noopener">mapbox-gl-framerate</a>.
  Pan or zoom the map to see live and average FPS.
</p>

<MapLibre @ref="_map"
          Options="_mapOptions"
          OnLoad="OnMapLoad"
          Class="rounded-top"
          Height="600px">
</MapLibre>

<div class="form-check mt-3">
    <input class="form-check-input" type="checkbox" id="fpsToggle" checked="@_fpsVisible" @onchange="ToggleFpsAsync" />
    <label class="form-check-label" for="fpsToggle">Show FPS graph</label>
</div>

@code {
    private MapLibre _map = new();
    private readonly FrameratePlugin _framerate = new();
    private bool _fpsVisible = true;
    private bool _pendingFramerateAdd;

    private readonly MapOptions _mapOptions = new()
    {
        Style = ExampleMapStyles.OpenStreetMap,
        Center = new LngLat(12.5, 41.9),
        Zoom = 5,
    };

    private static readonly FramerateControlOptions DefaultOptions = new()
    {
        Color = "#7cf859",
        Background = "rgba(0, 0, 0, 0.85)",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _map.RegisterPlugin(_framerate);

            if (_pendingFramerateAdd)
            {
                await AddFramerateIfVisibleAsync();
            }
        }
    }

    private async Task OnMapLoad(EventArgs _)
    {
        if (!_framerate.IsInitialized)
        {
            _pendingFramerateAdd = true;
            return;
        }

        await AddFramerateIfVisibleAsync();
    }

    private async Task AddFramerateIfVisibleAsync()
    {
        _pendingFramerateAdd = false;

        if (!_fpsVisible)
        {
            return;
        }

        await _framerate.AddFramerateControlAsync(DefaultOptions, ControlPosition.TopRight);
    }

    private async Task ToggleFpsAsync(ChangeEventArgs args)
    {
        _fpsVisible = args.Value is bool visible && visible;

        if (_fpsVisible)
        {
            await _framerate.AddFramerateControlAsync(DefaultOptions, ControlPosition.TopRight);
        }
        else
        {
            await _framerate.RemoveFramerateControlAsync();
        }
    }

    public async ValueTask DisposeAsync() => await _framerate.DisposeAsync();
}
