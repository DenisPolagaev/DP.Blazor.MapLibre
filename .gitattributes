# Text files are stored with LF and checked out with the platform EOL (CRLF on Windows).
* text=auto
*.sh text eol=lf

# Vendored third-party assets and generated bundles are kept byte-exact: no EOL rewriting.
**/vendor/** -text
**/dist/** -text
**/geogrid/** -text
**/pmtiles/** -text
**/geojson-antimeridian-cut/** -text

# Binary assets
*.wasm binary
*.db binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
